"use client";

import { useState, useEffect, useRef } from "react";
import {
  getAdminTickets,
  updateTicketStatus,
  sendAdminReply,
  logoutAdmin,
  getStatusLabel,
  type Ticket,
  type TicketStatus,
  getTicket,
} from "@/lib/api/tickets";
import {
  LogOut,
  Send,
  X,
  Paperclip,
  FileText,
  Download,
  User,
  Mail,
  Users,
  Tag,
  MessageSquare,
  Search,
  ChevronDown,
  ChevronUp,
  ArrowLeft,
  Menu,
} from "lucide-react";
import Image from "next/image";
import {
  useTicketChannel,
  useAdminTicketsChannel,
} from "@/lib/realtime/useTicketChannel";

export function AdminDashboard() {
  const [tickets, setTickets] = useState<Ticket[]>([]);
  const [filter, setFilter] = useState<"todos" | TicketStatus>("todos");
  const [selectedTicket, setSelectedTicket] = useState<Ticket | null>(null);
  const [replyText, setReplyText] = useState("");
  const [isSending, setIsSending] = useState(false);
  const [searchTerm, setSearchTerm] = useState("");
  const [files, setFiles] = useState<File[]>([]);
  const [infoOpen, setInfoOpen] = useState(false); // accordion en mobile
  const fileInputRef = useRef<HTMLInputElement>(null);
  const messagesEndRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    loadTickets();
  }, []);

  useEffect(() => {
    // messagesEndRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [selectedTicket?.ticket_replies]);

  useTicketChannel(selectedTicket?.id || null, async () => {
    await loadTickets();
  });

  useAdminTicketsChannel(async () => {
    await loadTickets();
  });

  const loadTickets = async () => {
    try {
      const updated = await getAdminTickets();
      setTickets(updated);
      if (selectedTicket?.id) {
        const fullTicket = await getTicket(selectedTicket.id, "admin");
        setSelectedTicket(fullTicket);
      }
    } catch (error) {
      console.error(error);
    }
  };

  const handleStatusChange = async (id: string, status: TicketStatus) => {
    try {
      await updateTicketStatus(id, status);
      await loadTickets();
    } catch (error) {
      console.error(error);
    }
  };

  const handleSendReply = async () => {
    if (!selectedTicket) return;
    if (!replyText.trim() && files.length === 0) return;
    try {
      setIsSending(true);
      await sendAdminReply(selectedTicket.id, replyText.trim(), files);
      setReplyText("");
      setFiles([]);
      await loadTickets();
    } catch (error) {
      console.error(error);
    } finally {
      setIsSending(false);
    }
  };

  const handleCloseTicket = () => {
    if (!selectedTicket) return;
    handleStatusChange(selectedTicket.id, "cerrado");
  };

  const handleLogout = async () => {
    await logoutAdmin();
    window.location.href = "/admin/login";
  };

  const filteredTickets = tickets.filter((ticket) => {
    const matchFilter = filter === "todos" || ticket.status === filter;
    const matchSearch =
      !searchTerm ||
      ticket.mail?.toLowerCase().includes(searchTerm.toLowerCase()) ||
      ticket.titular?.toLowerCase().includes(searchTerm.toLowerCase()) ||
      ticket.categoria?.toLowerCase().includes(searchTerm.toLowerCase()) ||
      ticket.subcategoria?.toLowerCase().includes(searchTerm.toLowerCase());
    return matchFilter && matchSearch;
  });

  const pendingCount = tickets.filter((t) => t.status === "pendiente").length;

  const formatDate = (dateString: string) =>
    new Date(dateString).toLocaleDateString("es-AR", {
      day: "2-digit",
      month: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
    });

  const formatDateFull = (dateString: string) =>
    new Date(dateString).toLocaleDateString("es-AR", {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });

  const getStatusStyle = (status: string) => {
    switch (status) {
      case "pendiente":
        return "bg-[rgba(240,180,41,0.15)] text-gold";
      case "respondido":
        return "bg-[rgba(46,204,113,0.12)] text-green";
      case "cerrado":
        return "bg-surface-3 text-muted-foreground";
      default:
        return "";
    }
  };

  const getCatIcon = (categoria: string) => {
    if (categoria.includes("Contraseña")) return "🔐";
    if (categoria.includes("2FA") || categoria.includes("Autenticación")) return "🛡️";
    if (categoria.includes("Correo") || categoria.includes("electrónico")) return "📧";
    if (categoria.includes("entrantes")) return "📥";
    if (categoria.includes("salientes")) return "📤";
    if (categoria.includes("Comisiones")) return "💰";
    if (categoria.includes("usuarios") || categoria.includes("Colaboradores")) return "👥";
    if (categoria.includes("Alias")) return "🏷️";
    if (categoria.includes("API") || categoria.includes("Integraciones") || categoria.includes("Webhook")) return "🔗";
    return "⚠️";
  };

  // En mobile mostramos lista O detalle (no ambos)
  const showListMobile = !selectedTicket;
  const showDetailMobile = !!selectedTicket;

  return (
    <div className="flex flex-col h-screen bg-background text-foreground">
      {/* ===== HEADER ===== */}
      <header className="flex items-center justify-between px-3 sm:px-6 py-2.5 sm:py-3 border-b border-border bg-surface">
        <div className="flex items-center gap-2 min-w-0">
          <span className="text-gold font-bold text-sm sm:text-base truncate">Admin</span>
          <span className="text-muted-foreground hidden xs:inline">·</span>
          <span className="text-muted-foreground text-xs sm:text-sm hidden xs:inline">Soporte</span>
        </div>

        <div className="flex items-center gap-1.5 sm:gap-3">
          {pendingCount > 0 && (
            <span className="text-[10px] sm:text-xs px-2 py-1 rounded-md bg-[rgba(240,180,41,0.15)] text-gold font-medium">
              {pendingCount}
              <span className="hidden sm:inline"> pendiente{pendingCount !== 1 ? "s" : ""}</span>
            </span>
          )}
          <span className="text-[10px] sm:text-xs text-muted-foreground hidden sm:inline">
            {tickets.length} total
          </span>
          <button
            onClick={handleLogout}
            className="flex items-center gap-1.5 px-2 sm:px-3 py-1.5 rounded-md text-xs text-muted-foreground hover:text-gold hover:bg-surface-2 transition-colors"
            aria-label="Salir"
          >
            <LogOut className="h-3.5 w-3.5" />
            <span className="hidden sm:inline">Salir</span>
          </button>
        </div>
      </header>

      {/* ===== LAYOUT ===== */}
      <div className="flex flex-1 min-h-0">
        {/* ----- SIDEBAR (lista) ----- */}
        <aside
          className={`${
            showListMobile ? "flex" : "hidden"
          } md:flex flex-col w-full md:w-[320px] lg:w-[360px] border-r border-border bg-surface min-h-0`}
        >
          {/* Filtros */}
          <div className="px-3 sm:px-4 pt-3">
            <div className="flex gap-1 p-1 bg-surface-2 rounded-lg overflow-x-auto">
              {(["todos", "pendiente", "respondido", "cerrado"] as const).map((f) => (
                <button
                  key={f}
                  onClick={() => setFilter(f)}
                  className={`flex-1 min-w-fit text-[11px] py-1.5 px-2 rounded-md transition-all font-medium whitespace-nowrap ${
                    filter === f
                      ? "bg-surface-3 text-foreground shadow-[0_1px_4px_rgba(0,0,0,0.3)]"
                      : "text-muted-foreground hover:text-foreground"
                  }`}
                >
                  {f === "todos" ? "Todos" : f === "respondido" ? "Resp." : f.charAt(0).toUpperCase() + f.slice(1)}
                  {f === "pendiente" && pendingCount > 0 && (
                    <span className="ml-1 inline-flex items-center justify-center text-[9px] bg-gold text-black rounded-full h-3.5 min-w-[14px] px-1">
                      {pendingCount}
                    </span>
                  )}
                </button>
              ))}
            </div>
          </div>

          {/* Search */}
          <div className="px-3 sm:px-4 py-3">
            <div className="relative">
              <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" />
              <input
                type="text"
                placeholder="Buscar..."
                value={searchTerm}
                onChange={(e) => setSearchTerm(e.target.value)}
                className="w-full py-2 pl-9 pr-3 bg-surface-2 border border-border rounded-lg text-[13px] text-foreground placeholder:text-[#444] focus:outline-none focus:border-gold-dim transition-colors"
              />
            </div>
          </div>

          {/* Lista de tickets */}
          <div className="flex-1 overflow-y-auto">
            {filteredTickets.length === 0 ? (
              <div className="p-6 text-center text-xs text-muted-foreground">
                Sin tickets{filter !== "todos" ? " en este estado" : ""}.
              </div>
            ) : (
              filteredTickets.map((ticket) => {
                const ticketNum = tickets.indexOf(ticket) + 1;
                return (
                  <div
                    key={ticket.id}
                    onClick={() => {
                      setSelectedTicket(ticket);
                      setInfoOpen(false);
                    }}
                    className={`px-3 sm:px-4 py-3 border-b border-border cursor-pointer transition-colors border-l-2 ${
                      selectedTicket?.id === ticket.id
                        ? "bg-surface-2 border-l-gold"
                        : "border-l-transparent hover:bg-surface-2"
                    }`}
                  >
                    <div className="flex items-center justify-between gap-2 mb-1">
                      <span className="text-[11px] text-muted-foreground">#{ticketNum}</span>
                      <span className="text-base">{getCatIcon(ticket.categoria)}</span>
                    </div>
                    <p className="text-[13px] font-medium text-foreground truncate">
                      {ticket.subcategoria}
                    </p>
                    <p className="text-[11px] text-muted-foreground truncate mt-0.5">
                      {ticket.titular} · {formatDate(ticket.created_at)}
                    </p>
                    <div className="mt-1.5">
                      <span className={`inline-block text-[10px] px-2 py-0.5 rounded-md ${getStatusStyle(ticket.status)}`}>
                        {ticket.status}
                      </span>
                    </div>
                  </div>
                );
              })
            )}
          </div>
        </aside>

        {/* ----- DETALLE ----- */}
        <main
          className={`${
            showDetailMobile ? "flex" : "hidden"
          } md:flex flex-1 flex-col min-h-0 min-w-0`}
        >
          {!selectedTicket ? (
            <div className="flex-1 flex flex-col items-center justify-center text-center p-6">
              <div className="text-4xl mb-3">💬</div>
              <p className="text-sm text-muted-foreground">
                Seleccioná un ticket para ver el detalle
              </p>
            </div>
          ) : (
            <>
              {/* Top bar del detalle */}
              <div className="flex items-center gap-2 px-3 sm:px-6 py-2.5 border-b border-border bg-surface">
                <button
                  onClick={() => setSelectedTicket(null)}
                  className="md:hidden p-1.5 rounded-md hover:bg-surface-2 text-muted-foreground"
                  aria-label="Volver"
                >
                  <ArrowLeft className="h-4 w-4" />
                </button>
                <div className="flex-1 min-w-0">
                  <p className="text-[13px] sm:text-sm font-semibold truncate">
                    {selectedTicket.subcategoria}
                  </p>
                  <p className="text-[10px] sm:text-[11px] text-muted-foreground truncate">
                    #{tickets.indexOf(selectedTicket) + 1} · {formatDateFull(selectedTicket.created_at)}
                  </p>
                </div>
                <span className={`text-[10px] sm:text-[11px] px-2 py-1 rounded-md whitespace-nowrap ${getStatusStyle(selectedTicket.status)}`}>
                  {getStatusLabel(selectedTicket.status)}
                </span>
              </div>

              {/* Cuerpo scrollable */}
              <div className="flex-1 overflow-y-auto px-3 sm:px-6 py-3 sm:py-4 space-y-3 sm:space-y-4">
                {/* Acordeón Info (en mobile colapsable, en desktop siempre abierto) */}
                <div className="border border-border rounded-lg bg-surface">
                  <button
                    onClick={() => setInfoOpen((v) => !v)}
                    className="w-full flex items-center justify-between px-3 sm:px-4 py-2.5 md:cursor-default"
                  >
                    <span className="text-[12px] uppercase tracking-wide text-muted-foreground font-semibold">
                      Información
                    </span>
                    <span className="md:hidden text-muted-foreground">
                      {infoOpen ? <ChevronUp className="h-4 w-4" /> : <ChevronDown className="h-4 w-4" />}
                    </span>
                  </button>

                  <div className={`${infoOpen ? "block" : "hidden"} md:block px-3 sm:px-4 pb-3 sm:pb-4 space-y-3`}>
                    <div className="grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-3">
                      <div>
                        <div className="flex items-center gap-1.5 text-[10px] uppercase text-muted-foreground mb-1">
                          <Mail className="h-3 w-3" /> Mail
                        </div>
                        <p className="text-[12px] break-all">{selectedTicket.mail}</p>
                      </div>
                      <div>
                        <div className="flex items-center gap-1.5 text-[10px] uppercase text-muted-foreground mb-1">
                          <User className="h-3 w-3" /> Titular
                        </div>
                        <p className="text-[12px]">{selectedTicket.titular}</p>
                      </div>
                      <div>
                        <div className="flex items-center gap-1.5 text-[10px] uppercase text-muted-foreground mb-1">
                          <Users className="h-3 w-3" /> Grupo Signal
                        </div>
                        <p className="text-[12px]">{selectedTicket.grupo}</p>
                      </div>
                    </div>

                    <div className="flex items-center gap-2 px-3 py-2 bg-surface-2 rounded-md text-[12px] flex-wrap">
                      <span>{getCatIcon(selectedTicket.categoria)}</span>
                      <span className="font-medium">{selectedTicket.categoria}</span>
                      <span className="text-muted-foreground">·</span>
                      <span className="text-muted-foreground truncate">{selectedTicket.subcategoria}</span>
                    </div>

                    <div className="p-3 bg-surface-2 border border-border rounded-md text-[13px] whitespace-pre-wrap leading-relaxed">
                      {selectedTicket.detalle}
                    </div>

                    {selectedTicket.ticket_attachments && selectedTicket.ticket_attachments.length > 0 && (
                      <div className="flex flex-wrap gap-2">
                        {selectedTicket.ticket_attachments.map((attachment, index) =>
                          attachment.file_type.startsWith("image/") ? (
                            <a key={index} href={attachment.file_url} target="_blank" rel="noreferrer" className="block">
                              <img
                                src={attachment.file_url}
                                alt={attachment.file_name}
                                className="h-20 w-20 sm:h-24 sm:w-24 object-cover rounded-md border border-border"
                              />
                            </a>
                          ) : (
                            <a
                              key={index}
                              href={attachment.file_url}
                              target="_blank"
                              rel="noreferrer"
                              className="flex items-center gap-2 px-3 py-2 bg-surface-2 border border-border rounded-md text-[12px] max-w-full"
                            >
                              <FileText className="h-3.5 w-3.5 shrink-0" />
                              <span className="truncate max-w-[160px] sm:max-w-[220px]">{attachment.file_name}</span>
                              <Download className="h-3.5 w-3.5 shrink-0 text-muted-foreground" />
                            </a>
                          )
                        )}
                      </div>
                    )}
                  </div>
                </div>

                {/* Conversación */}
                <div>
                  <div className="text-[12px] uppercase tracking-wide text-muted-foreground font-semibold mb-2 px-1">
                    Conversación
                  </div>
                  <div className="space-y-3">
                    {selectedTicket.ticket_replies?.length === 0 && (
                      <p className="text-center text-xs text-muted-foreground py-4">Sin respuestas aún</p>
                    )}
                    {selectedTicket.ticket_replies?.map((reply) => (
                      <div
                        key={reply.id}
                        className={`flex flex-col ${reply.is_admin ? "items-end" : "items-start"}`}
                      >
                        <span className="text-[10px] text-muted-foreground mb-1 px-1">
                          {formatDate(reply.created_at)}
                        </span>
                        <div
                          className={`max-w-[85%] sm:max-w-[75%] px-3 py-2 rounded-lg text-[13px] leading-relaxed ${
                            reply.is_admin
                              ? "bg-gold/10 border border-gold-dim text-foreground"
                              : "bg-surface-2 border border-border text-foreground"
                          }`}
                        >
                          <p className="whitespace-pre-wrap break-words">{reply.content}</p>
                          {(reply.ticket_attachments?.length ?? 0) > 0 && (
                            <div className="mt-2 flex flex-wrap gap-2">
                              {reply.ticket_attachments?.map((attachment, i) =>
                                attachment.file_type.startsWith("image/") ? (
                                  <a key={i} href={attachment.file_url} target="_blank" rel="noreferrer">
                                    <img
                                      src={attachment.file_url}
                                      alt={attachment.file_name}
                                      className="h-20 w-20 sm:h-24 sm:w-24 object-cover rounded-md border border-border"
                                    />
                                  </a>
                                ) : (
                                  <a
                                    key={i}
                                    href={attachment.file_url}
                                    target="_blank"
                                    rel="noreferrer"
                                    className="flex items-center gap-2 px-2 py-1 bg-surface border border-border rounded-md text-[11px] max-w-full"
                                  >
                                    <FileText className="h-3 w-3 shrink-0" />
                                    <span className="truncate max-w-[140px]">{attachment.file_name}</span>
                                  </a>
                                )
                              )}
                            </div>
                          )}
                        </div>
                        <span className="text-[10px] text-muted-foreground mt-1 px-1">
                          {reply.is_admin ? "Soporte" : "Cliente"}
                        </span>
                      </div>
                    ))}
                    <div ref={messagesEndRef} />
                  </div>
                </div>
              </div>

              {/* Input de respuesta */}
              <div className="border-t border-border bg-surface px-3 sm:px-6 py-3 space-y-2">
                {selectedTicket.status === "cerrado" ? (
                  <p className="text-center text-xs text-muted-foreground py-2">
                    Este ticket está cerrado. No se pueden enviar más respuestas.
                  </p>
                ) : (
                  <>
                    <textarea
                      value={replyText}
                      onChange={(e) => setReplyText(e.target.value)}
                      placeholder="Escribí tu respuesta..."
                      rows={2}
                      className="w-full px-3 sm:px-4 py-2.5 sm:py-3 bg-surface border border-border-2 rounded-lg text-sm text-foreground placeholder:text-[#444] focus:outline-none focus:border-gold-dim focus:shadow-[0_0_0_3px_rgba(240,180,41,0.07)] transition-all resize-none leading-relaxed"
                    />

                    {files.length > 0 && (
                      <div className="flex flex-wrap gap-2">
                        {files.map((file, index) => (
                          <div
                            key={index}
                            className="flex items-center gap-2 px-2.5 py-1.5 bg-surface-2 border border-border rounded-lg text-[11px]"
                          >
                            <Paperclip className="h-3 w-3" />
                            <span className="max-w-[100px] sm:max-w-[140px] truncate">{file.name}</span>
                            <button
                              type="button"
                              onClick={() => setFiles(files.filter((_, i) => i !== index))}
                            >
                              <X className="h-3 w-3 text-muted-foreground hover:text-red-400" />
                            </button>
                          </div>
                        ))}
                      </div>
                    )}

                    <div className="flex items-center justify-between gap-2">
                      <button
                        onClick={handleCloseTicket}
                        className="px-2.5 sm:px-4 py-2 sm:py-2.5 border border-red-500 text-red-500 rounded-lg text-[12px] sm:text-[13px] bg-transparent hover:text-gold hover:border-gold-dim transition-all whitespace-nowrap"
                      >
                        <span className="sm:hidden">Cerrar</span>
                        <span className="hidden sm:inline">Cerrar ticket</span>
                      </button>

                      <div className="flex gap-1.5 sm:gap-2 items-center">
                        <input
                          ref={fileInputRef}
                          type="file"
                          multiple
                          accept="image/*,.pdf,.doc,.docx"
                          className="hidden"
                          onChange={(e) => {
                            if (!e.target.files) return;
                            setFiles(Array.from(e.target.files));
                          }}
                        />

                        <button
                          type="button"
                          onClick={() => fileInputRef.current?.click()}
                          className="px-2.5 sm:px-3 py-2 sm:py-2.5 border border-border-2 rounded-lg text-muted-foreground hover:text-gold-dim hover:border-gold-dim transition-all"
                          aria-label="Adjuntar"
                        >
                          <Paperclip className="h-4 w-4" />
                        </button>

                        <button
                          onClick={handleSendReply}
                          disabled={(!replyText.trim() && files.length === 0) || isSending}
                          className="px-3 sm:px-5 py-2 sm:py-2.5 bg-gradient-to-br from-gold to-[#C8881A] border-none rounded-lg text-[12px] sm:text-[13px] font-bold text-black cursor-pointer hover:opacity-90 transition-all disabled:opacity-35 disabled:cursor-not-allowed flex items-center gap-1.5 whitespace-nowrap"
                        >
                          {isSending ? (
                            <>
                              <span className="w-[12px] h-[12px] border-2 border-[rgba(0,0,0,0.25)] border-t-black rounded-full animate-spin" />
                              <span className="hidden sm:inline">Enviando...</span>
                            </>
                          ) : (
                            <>
                              <Send className="h-3.5 w-3.5" />
                              <span className="hidden sm:inline">Enviar respuesta</span>
                              <span className="sm:hidden">Enviar</span>
                            </>
                          )}
                        </button>
                      </div>
                    </div>
                  </>
                )}
              </div>
            </>
          )}
        </main>
      </div>
    </div>
  );
}
